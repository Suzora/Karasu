<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-written (restore from git after a wiped re-init). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/karasu_widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="11dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/w_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_title"
                style="@style/KarasuWidgetText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_count"
                style="@style/KarasuWidgetMuted"
                android:layout_width="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_hero"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_hero_cover"
                android:layout_width="60dp"
                android:layout_height="88dp"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_hero_label"
                    style="@style/KarasuWidgetMuted"
                    android:textColor="@color/kw_accent"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_hero_title"
                    style="@style/KarasuWidgetText"
                    android:layout_marginTop="1dp"
                    android:maxLines="2"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/w_hero_big"
                        style="@style/KarasuWidgetText"
                        android:layout_width="wrap_content"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <Chronometer
                        android:id="@+id/w_hero_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/kw_ink_100"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/w_hero_sub"
                        style="@style/KarasuWidgetMuted"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/w_hero_bar"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="6dp"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_rest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_footer"
            style="@style/KarasuWidgetMuted"
            android:layout_marginTop="6dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
