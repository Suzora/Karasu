<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-written (restore from git after a wiped re-init). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_tile"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_marginEnd="6dp"
    android:background="@drawable/karasu_widget_tile"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/w_tile_value"
        style="@style/KarasuWidgetText"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_tile_label"
        style="@style/KarasuWidgetMuted" />
</LinearLayout>
