<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-written (restore from git after a wiped re-init). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_item"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/w_item_cover"
        android:layout_width="22dp"
        android:layout_height="31dp"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_item_title"
            style="@style/KarasuWidgetText"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_item_sub"
            style="@style/KarasuWidgetMuted" />
    </LinearLayout>
</LinearLayout>
