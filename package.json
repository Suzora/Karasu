{
  "name": "karasu",
  "private": true,
  "version": "1.79.7",
  "type": "module",
  "author": "Kyusetzu",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "verify:frontend": "node scripts/verify.mjs --frontend",
    "verify:rust": "node scripts/verify.mjs --rust",
    "bump": "node scripts/bump-version.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:dom": "vitest run --project dom",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed HEAD",
    "clean:target": "node scripts/clean-target.mjs",
    "lint": "oxlint --deny-warnings",
    "lint:typos": "typos --format brief",
    "lint:toml": "node scripts/toml-check.mjs",
    "lint:md": "markdownlint-cli2",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "deny": "cargo deny --manifest-path src-tauri/Cargo.toml check",
    "deps:unused": "cargo machete --with-metadata src-tauri",
    "bloat": "cargo bloat --manifest-path src-tauri/Cargo.toml --release --crates -n 30",
    "mutants": "node scripts/mutants.mjs",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build && powershell -ExecutionPolicy Bypass -File scripts/release/rename-installer.ps1"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@choochmeque/tauri-plugin-sharekit-api": "^0.4.0-rc.8",
    "@fontsource/kosugi-maru": "^5.3.0",
    "@fontsource/sn-pro": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.2",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-haptics": "^2.4.2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "i18next": "^26.7.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.107.1",
    "@taplo/cli": "^0.7.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.2",
    "markdownlint-cli2": "^0.18.1",
    "oxc-parser": "^0.158.0",
    "oxlint": "^1.93.0",
    "playwright-core": "^1.65.0",
    "react-scan": "^0.5.7",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
